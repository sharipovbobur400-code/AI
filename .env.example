# Solar Factory WMS — server sozlamalari (.env faylga nusxalang). Bu fayldagi qiymatlar frontendga HECH QACHON uzatilmaydi.
PORT=3000
HOST=127.0.0.1                 # tarmoqqa ochish uchun 0.0.0.0 (faqat HTTPS proksi ortida!)
DATA_DIR=data                  # SQLite baza, fayllar, backuplar
DB_FILE=wms.db
SEED=real                      # real = bo'sh baza (faqat ombor tuzilmasi); demo = namunaviy ma'lumotlar (testlar uchun)
SUPERADMIN_LOGIN=              # birinchi ishga tushirishda super admin (bo'sh bo'lsa — saytda sozlash sahifasi ochiladi)
SUPERADMIN_NAME=
SUPERADMIN_PASSWORD=

# AI (ixtiyoriy). Google Gemini (AIza… yoki AQ.…) yoki Anthropic (sk-ant-…) kaliti. Saytdagi "API kalitlari" bo'limidan ham kiritiladi (shifrlanadi).
AI_API_KEY=
AI_MODEL=                      # bo'sh — gemini-flash-latest / claude-sonnet-5
AI_SCAN_SECONDS=60             # AI monitoring davriyligi (shortage, kechikish, sig'im, deadline)

# Xavfsizlik
TLS_CERT=                      # to'g'ridan-to'g'ri HTTPS uchun sertifikat yo'li
TLS_KEY=
BEHIND_HTTPS=0                 # 1 — Nginx/Caddy HTTPS proksi ortida (Secure cookie + HSTS)
TRUST_PROXY=0                  # 1 — X-Forwarded-For dan IP olish
RATE_LIMIT_PER_MIN=1200
BACKUP_DAILY=1
BACKUP_KEEP=14

# Telegram bot (ixtiyoriy). @BotFather → /newbot → token. Bo'sh bo'lsa bot o'chirilgan.
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_CHAT_ID=        # ixtiyoriy: barcha hodisalar yuboriladigan monitoring guruhi (chat id)
WMS_BASE_URL=                  # xabarlardagi "Saytda ochish" havolalari uchun, masalan https://wms.korxona.uz
BOT_BATCH_SECONDS=20           # ombor harakatlari shuncha soniyada bitta xabarga jamlanadi
BOT_MORNING_HOUR=8             # AI ertalabki hisobot (omborda yuk / bugun chiqadigan yuk)
BOT_EVENING_HOUR=22            # AI kechki hisobot (shuncha yuk chiqdi / qoldi)
BOT_TZ_OFFSET_MIN=300          # UTC+5 (Toshkent)
BOT_ESCALATE_MINUTES=30        # kritik alert shuncha daqiqa "Ko'rildi" qilinmasa — direktor/menejerga eskalatsiya

# AI dispetcher
DISPATCH_CYCLE_SECONDS=60      # har necha soniyada qadoqlangan buyurtmalar uchun transport qidiriladi
WMS_MASTER_KEY=                # ixtiyoriy: kalitlarni shifrlash uchun master kalit (bo'sh — data/.master.key avtomatik yaratiladi)

# Yuklanadigan fayllar: auto — Windows Defender / ClamAV topilsa skanerlaydi; required — antivirus bo‘lmasa fayl qabul qilinmaydi; off — faqat format tekshiruvi
ANTIVIRUS=auto

# Jamoa botlari (sayt ichida ishlaydi; tokenlarni saytda ham kiritish mumkin: Sozlamalar → Telegram botlar)
TAMINOT_BOT_TOKEN=
OMBOR_BOT_TOKEN=
ISHLAB_BOT_TOKEN=
XULOSA_BOT_TOKEN=
TEAMBOTS_ADMIN_IDS=            # shaxsiy chatda botlar bilan gaplasha oladigan Telegram ID lar (vergul bilan)
STT_API_KEY=                   # ovozli xabarlar uchun Gemini kaliti (aistudio.google.com)
# AI: Anthropic (console.anthropic.com → API Keys, sk-ant-…) yoki Gemini — AI_API_KEY / ANTHROPIC_API_KEY
